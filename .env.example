# Create a Google Cloud OAuth web client, enable Gmail API, and register:
# http://127.0.0.1:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Optional higher rate limit for the Himalayas jobs API
HIMALAYAS_API_KEY=
# Optional: X developer app bearer token for recent hiring-post search
X_BEARER_TOKEN=
